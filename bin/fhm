#!/usr/bin/env bash
# Generated by Github Copilot on behalf of Tim Livingston

set -u

INTERVAL=5
TIMEOUT=1
DHCPD_CONFIG='/etc/dhcp/dhcpd.conf'
CONFIG_GLOB='/etc/dhcp/ansible*.conf'

usage() {
    cat <<'EOF'
Usage: fhm [-i seconds] [-t seconds] [-g config-glob]

Continuously displays the ping status of static hosts defined in dhcpd.conf and
matching ISC DHCP configuration files. Each host block must contain a
fixed-address directive.

Options:
  -i seconds      Refresh interval (default: 5)
  -t seconds      Timeout for each ping (default: 1)
    -g config-glob  Additional DHCP configuration file glob
                  (default: /etc/dhcp/ansible*.conf)
  -h              Show this help
EOF
}

is_positive_number() {
    [[ $1 =~ ^[0-9]+([.][0-9]+)?$ ]] && awk -v value="$1" 'BEGIN { exit !(value > 0) }'
}

while getopts ':i:t:g:h' option; do
    case "$option" in
        i) INTERVAL=$OPTARG ;;
        t) TIMEOUT=$OPTARG ;;
        g) CONFIG_GLOB=$OPTARG ;;
        h) usage; exit 0 ;;
        :) printf 'Option -%s requires an argument.\n' "$OPTARG" >&2; exit 2 ;;
        \?) printf 'Unknown option: -%s\n' "$OPTARG" >&2; usage >&2; exit 2 ;;
    esac
done

if ! is_positive_number "$INTERVAL" || ! is_positive_number "$TIMEOUT"; then
    printf 'Interval and timeout must be positive numbers.\n' >&2
    exit 2
fi

if ! command -v ping >/dev/null 2>&1; then
    printf 'ping is required but was not found in PATH.\n' >&2
    exit 1
fi

declare -a config_files=()
if [[ -f $DHCPD_CONFIG ]]; then
    config_files+=("$DHCPD_CONFIG")
fi
while IFS= read -r config_file; do
    [[ -f $config_file && $config_file != "$DHCPD_CONFIG" ]] && config_files+=("$config_file")
done < <(compgen -G "$CONFIG_GLOB" | sort)

if ((${#config_files[@]} == 0)); then
    printf 'No configuration files found at %s or matching %s\n' "$DHCPD_CONFIG" "$CONFIG_GLOB" >&2
    exit 1
fi

read_hosts() {
    awk '
        function emit(block, name, value, values, count, item_number) {
            if (!match(block, /host[[:space:]]+[^[:space:]{]+/)) return
            name = substr(block, RSTART, RLENGTH)
            sub(/^host[[:space:]]+/, "", name)

            if (!match(block, /fixed-address[[:space:]]+[^;]+;/)) return
            value = substr(block, RSTART, RLENGTH)
            sub(/^fixed-address[[:space:]]+/, "", value)
            sub(/;$/, "", value)
            hierarchy = name
            sub(/^[^c]*c/, "c", hierarchy)
            count = split(value, values, /[[:space:]]*,[[:space:]]*/)
            for (item_number = 1; item_number <= count; item_number++) {
                print hierarchy "\t" name "\t" values[item_number]
            }
        }

        {
            line = $0
            sub(/#.*/, "", line)
            if (!collecting && line ~ /(^|[[:space:]])host[[:space:]]+[^[:space:]{]+[[:space:]]*\{/) {
                collecting = 1
                block = ""
            }
            if (collecting) {
                block = block " " line
                opens += gsub(/\{/, "{", line)
                closes += gsub(/\}/, "}", line)
                if (opens > 0 && opens == closes) {
                    emit(block)
                    collecting = opens = closes = 0
                    block = ""
                }
            }
        }
    ' "$@" | sort -t $'\t' -k1,1V -k2,2 -k3,3 -u | cut -f2-
}

is_octe_host() {
    [[ $1 =~ (^|[^[:alnum:]])[oO][cC][tT][eE][0-9]+([^[:alnum:]]|$) ]]
}

# First three octets of the first local IPv4 address in 10.204.x.x or 10.198.x.x;
# core switches live on that subnet at .134 (core 1), .135 (core 2), ...
find_switch_prefix() {
    local addresses
    if command -v ip >/dev/null 2>&1; then
        addresses=$(ip -4 -o addr show 2>/dev/null | awk '{split($4, a, "/"); print a[1]}')
    else
        addresses=$(hostname -I 2>/dev/null | tr ' ' '\n')
    fi
    awk -F. '$1 == 10 && ($2 == 204 || $2 == 198) { print $1 "." $2 "." $3; exit }' <<<"$addresses"
}
switch_prefix=$(find_switch_prefix)

declare -a host_names=()
declare -a host_addresses=()
while IFS=$'\t' read -r name address; do
    [[ -n $name && -n $address ]] || continue
    host_names+=("$name")
    host_addresses+=("$address")
done < <(read_hosts "${config_files[@]}")

if ((${#host_names[@]} == 0)); then
    printf 'No host blocks with fixed-address directives found in %s\n' "$CONFIG_GLOB" >&2
    exit 1
fi

declare -a display_types=()
declare -a display_labels=()
declare -a display_host_indexes=()
declare -a display_indents=()
octe_section_added=0
for index in "${!host_names[@]}"; do
    if is_octe_host "${host_names[index]}"; then
        if ((octe_section_added == 0)); then
            display_types+=('header')
            display_labels+=('[OCTE]')
            display_host_indexes+=('-1')
            display_indents+=('0')
            octe_section_added=1
        fi
        display_types+=('host')
        display_labels+=('')
        display_host_indexes+=("$index")
        display_indents+=('1')
    fi
done
previous_core=''
previous_node=''
core_position=0
for index in "${!host_names[@]}"; do
    if is_octe_host "${host_names[index]}"; then
        continue
    fi
    host_indent=0
    if [[ ${host_names[index]} =~ c([0-9]+)n([0-9]+)r([0-9]+)(e([0-9]+))? ]]; then
        core="c${BASH_REMATCH[1]}"
        node_value=${BASH_REMATCH[2]}
        rack_value=${BASH_REMATCH[3]}
        equipment_value=${BASH_REMATCH[5]}

        if [[ $core != "$previous_core" ]]; then
            display_types+=('header')
            display_labels+=("[$core]")
            display_host_indexes+=('-1')
            display_indents+=('0')
            previous_core=$core
            previous_node=''
            core_position=$((core_position + 1))
            if [[ -n $switch_prefix ]]; then
                host_names+=("${core}-core-switch")
                host_addresses+=("$switch_prefix.$((133 + core_position))")
                display_types+=('host')
                display_labels+=('')
                display_host_indexes+=("$((${#host_names[@]} - 1))")
                display_indents+=('1')
            fi
        fi
        host_indent=1
        if [[ ! $node_value =~ ^0+$ ]]; then
            node="n$node_value"
            if [[ $node != "$previous_node" ]]; then
                display_types+=('header')
                display_labels+=("[$node]")
                display_host_indexes+=('-1')
                display_indents+=("$host_indent")
                previous_node=$node
            fi
            ((host_indent++))
        fi
        if [[ ! $rack_value =~ ^0+$ ]]; then
            ((host_indent++))
        fi
        if [[ -n $equipment_value && ! $equipment_value =~ ^0+$ ]]; then
            ((host_indent++))
        fi
    else
        if [[ $previous_core != Unclassified ]]; then
            display_types+=('header')
            display_labels+=('[Unclassified]')
            display_host_indexes+=('-1')
            display_indents+=('0')
            previous_core='Unclassified'
            previous_node=''
        fi
        host_indent=1
    fi
    display_types+=('host')
    display_labels+=('')
    display_host_indexes+=("$index")
    display_indents+=("$host_indent")
done

result_dir=$(mktemp -d)
interactive_output=0
cleanup() {
    rm -rf -- "$result_dir"
    if ((interactive_output)); then
        printf '\033[?25h\033[?1049l'
    fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

ping_host() {
    local index=$1 output latency
    if output=$(ping -n -c 1 -W "$TIMEOUT" "${host_addresses[index]}" 2>&1); then
        latency=$(awk -F'time=' '/time=/{split($2, parts, " "); print parts[1]; exit}' <<<"$output")
        printf 'UP\t%s\n' "${latency:--}" >"$result_dir/$index"
    else
        printf 'DOWN\t-\n' >"$result_dir/$index"
    fi
}

wait_for_refresh_or_navigation() {
    local key='' sequence=''

    if ((!interactive_output)) || [[ ! -t 0 ]]; then
        sleep "$INTERVAL"
        return
    fi

    if IFS= read -rsn1 -t "$INTERVAL" key && [[ $key == $'\e' ]]; then
        IFS= read -rsn2 -t 0.1 sequence || true
        case "$sequence" in
            '[C')
                if ((current_page + 1 < page_count)); then
                    current_page=$((current_page + 1))
                fi
                ;;
            '[D')
                if ((current_page > 0)); then
                    current_page=$((current_page - 1))
                fi
                ;;
        esac
    fi
}

if [[ -t 1 && ${TERM:-dumb} != dumb ]]; then
    interactive_output=1
    printf '\033[?1049h\033[?25l\033[2J\033[H'
fi

current_page=0
while true; do
    pids=()
    for index in "${!host_names[@]}"; do
        ping_host "$index" &
        pids+=("$!")
    done
    for pid in "${pids[@]}"; do
        wait "$pid" || true
    done

    up_count=0
    for index in "${!host_names[@]}"; do
        if [[ -f $result_dir/$index ]]; then
            IFS=$'\t' read -r status _ <"$result_dir/$index"
            [[ $status == UP ]] && up_count=$((up_count + 1))
        fi
    done
    host_total=${#host_names[@]}
    if ((host_total > 0)); then
        up_percent=$((up_count * 100 / host_total))
    else
        up_percent=0
    fi

    if ((interactive_output)); then
        printf '\033[H'
        terminal_rows=$(tput lines 2>/dev/null || printf '24')
        terminal_columns=$(tput cols 2>/dev/null || printf '80')
    else
        terminal_rows=$((${#display_types[@]} + 4))
        terminal_columns=80
    fi

    [[ $terminal_rows =~ ^[0-9]+$ ]] || terminal_rows=24
    [[ $terminal_columns =~ ^[0-9]+$ ]] || terminal_columns=80
    layout_width=$((terminal_columns > 1 ? terminal_columns - 1 : 1))
    grid_rows=$((terminal_rows - 4))
    ((grid_rows > 0)) || grid_rows=1

    minimum_cell_width=46
    max_columns=$((layout_width / minimum_cell_width))
    ((max_columns > 0)) || max_columns=1
    needed_columns=$((${#display_types[@]} + grid_rows - 1))
    needed_columns=$((needed_columns / grid_rows))
    ((needed_columns > 0)) || needed_columns=1
    if ((needed_columns < max_columns)); then
        column_count=$needed_columns
    else
        column_count=$max_columns
    fi

    page_capacity=$((grid_rows * column_count))
    page_count=$((${#display_types[@]} + page_capacity - 1))
    page_count=$((page_count / page_capacity))
    ((current_page < page_count)) || current_page=0
    page_start=$((current_page * page_capacity))
    page_item_count=$((${#display_types[@]} - page_start))
    ((page_item_count < page_capacity)) || page_item_count=$page_capacity
    page_rows=$((page_item_count + column_count - 1))
    page_rows=$((page_rows / column_count))
    cell_width=$((layout_width / column_count))
    separator_width=1
    host_width=1
    for ((entry_index = page_start; entry_index < page_start + page_item_count; entry_index++)); do
        [[ ${display_types[entry_index]} == host ]] || continue
        index=${display_host_indexes[entry_index]}
        candidate_width=$((${display_indents[entry_index]} + ${#host_names[index]}))
        ((candidate_width > host_width)) && host_width=$candidate_width
    done
    maximum_host_width=$((cell_width - separator_width - 1))
    ((host_width <= maximum_host_width)) || host_width=$maximum_host_width
    ((host_width > 0)) || host_width=1
    detail_width=$((cell_width - host_width - separator_width))

    printf -v heading 'Network host status  %(%Y-%m-%d %H:%M:%S)T  |  UP %d%% (%d/%d)' -1 \
        "$up_percent" "$up_count" "$host_total"
    printf '%.*s\n\n' "$layout_width" "$heading"

    for ((row = 0; row < page_rows; row++)); do
        for ((column = 0; column < column_count; column++)); do
            entry_index=$((page_start + column * page_rows + row))
            ((entry_index < page_start + page_item_count)) || continue

            if [[ ${display_types[entry_index]} == header ]]; then
                printf -v indentation '%*s' "${display_indents[entry_index]}" ''
                header="${indentation}${display_labels[entry_index]}"
                if ((interactive_output)); then
                    printf '\033[1;36m%-*.*s\033[0m' "$cell_width" "$cell_width" "$header"
                else
                    printf '%-*.*s' "$cell_width" "$cell_width" "$header"
                fi
                continue
            fi

            index=${display_host_indexes[entry_index]}
            printf -v indentation '%*s' "${display_indents[entry_index]}" ''
            host_display="${indentation}${host_names[index]}"
            IFS=$'\t' read -r status latency <"$result_dir/$index"
            latency_text=$latency
            [[ $latency == - ]] || latency_text="${latency}ms"
            details="${host_addresses[index]}  $latency_text"

            if ((interactive_output)) && [[ $status == UP ]]; then
                printf '\033[32m%-*.*s\033[0m' "$host_width" "$host_width" "$host_display"
            elif ((interactive_output)); then
                printf '\033[31m%-*.*s\033[0m' "$host_width" "$host_width" "$host_display"
            else
                printf '%-*.*s' "$host_width" "$host_width" "$host_display"
            fi
            printf '%*s' "$separator_width" ''
            if ((detail_width > 0)); then
                printf '%-*.*s' "$detail_width" "$detail_width" "$details"
            fi
        done
        printf '\n'
    done

    printf -v footer 'Refresh: %ss | Hosts: %d | Page: %d/%d | Left/Right: page | Ctrl-C: stop' \
        "$INTERVAL" "${#host_names[@]}" "$((current_page + 1))" "$page_count"
    printf '\n%.*s' "$layout_width" "$footer"
    if ((interactive_output)); then
        printf '\033[J'
    else
        printf '\n'
    fi
    wait_for_refresh_or_navigation
done
