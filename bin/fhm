#!/usr/bin/env bash
# Generated by Github Copilot on behalf of Tim Livingston

set -u

INTERVAL=5
TIMEOUT=1
DHCPD_CONFIG='/etc/dhcp/dhcpd.conf'
CONFIG_GLOB='/etc/dhcp/ansible*.conf'
TITLE='Fluence Host Monitor'
BUILD=12
show_mac=0
collapse_down_cores=0

usage() {
    cat <<'EOF'
Usage: fhm [-i seconds] [-t seconds] [-g config-glob] [-m] [-c]

Continuously displays the ping status of static hosts defined in dhcpd.conf and
matching ISC DHCP configuration files. Each host block must contain a
fixed-address directive.

Options:
  -i seconds      Refresh interval (default: 5)
  -t seconds      Timeout for each ping (default: 1)
    -g config-glob  Additional DHCP configuration file glob
                  (default: /etc/dhcp/ansible*.conf)
  -m              Show MAC addresses next to IP addresses (toggle with M)
  -c              Collapse cores whose core switch is not pingable (toggle with C)
  -h              Show this help
EOF
}

is_positive_number() {
    [[ $1 =~ ^[0-9]+([.][0-9]+)?$ ]] && awk -v value="$1" 'BEGIN { exit !(value > 0) }'
}

while getopts ':i:t:g:mch' option; do
    case "$option" in
        i) INTERVAL=$OPTARG ;;
        t) TIMEOUT=$OPTARG ;;
        g) CONFIG_GLOB=$OPTARG ;;
        m) show_mac=1 ;;
        c) collapse_down_cores=1 ;;
        h) usage; exit 0 ;;
        :) printf 'Option -%s requires an argument.\n' "$OPTARG" >&2; exit 2 ;;
        \?) printf 'Unknown option: -%s\n' "$OPTARG" >&2; usage >&2; exit 2 ;;
    esac
done

if ! is_positive_number "$INTERVAL" || ! is_positive_number "$TIMEOUT"; then
    printf 'Interval and timeout must be positive numbers.\n' >&2
    exit 2
fi

if ! command -v ping >/dev/null 2>&1; then
    printf 'ping is required but was not found in PATH.\n' >&2
    exit 1
fi

declare -a config_files=()
if [[ -f $DHCPD_CONFIG ]]; then
    config_files+=("$DHCPD_CONFIG")
fi
while IFS= read -r config_file; do
    [[ -f $config_file && $config_file != "$DHCPD_CONFIG" ]] && config_files+=("$config_file")
done < <(compgen -G "$CONFIG_GLOB" | sort)

if ((${#config_files[@]} == 0)); then
    printf 'No configuration files found at %s or matching %s\n' "$DHCPD_CONFIG" "$CONFIG_GLOB" >&2
    exit 1
fi

read_hosts() {
    awk '
        function emit(block, name, value, values, count, item_number) {
            if (!match(block, /host[[:space:]]+[^[:space:]{]+/)) return
            name = substr(block, RSTART, RLENGTH)
            sub(/^host[[:space:]]+/, "", name)

            if (!match(block, /fixed-address[[:space:]]+[^;]+;/)) return
            value = substr(block, RSTART, RLENGTH)
            sub(/^fixed-address[[:space:]]+/, "", value)
            sub(/;$/, "", value)
            mac = "-"
            if (match(block, /hardware[[:space:]]+ethernet[[:space:]]+[^;]+;/)) {
                mac = substr(block, RSTART, RLENGTH)
                sub(/^hardware[[:space:]]+ethernet[[:space:]]+/, "", mac)
                sub(/;$/, "", mac)
                gsub(/[[:space:]]+/, "", mac)
                if (mac == "") mac = "-"
            }
            hierarchy = name
            sub(/^[^c]*c/, "c", hierarchy)
            count = split(value, values, /[[:space:]]*,[[:space:]]*/)
            for (item_number = 1; item_number <= count; item_number++) {
                print hierarchy "\t" name "\t" values[item_number] "\t" mac
            }
        }

        {
            line = $0
            sub(/#.*/, "", line)
            if (!collecting && line ~ /(^|[[:space:]])host[[:space:]]+[^[:space:]{]+[[:space:]]*\{/) {
                collecting = 1
                block = ""
            }
            if (collecting) {
                block = block " " line
                opens += gsub(/\{/, "{", line)
                closes += gsub(/\}/, "}", line)
                if (opens > 0 && opens == closes) {
                    emit(block)
                    collecting = opens = closes = 0
                    block = ""
                }
            }
        }
    ' "$@" | sort -t $'\t' -k1,1V -k2,2 -k3,3 -u | cut -f2-
}

is_octe_host() {
    [[ $1 =~ (^|[^[:alnum:]])[oO][cC][tT][eE][0-9]+([^[:alnum:]]|$) ]]
}

is_ups_host() {
    [[ $1 =~ (^|[^[:alnum:]])[uU][pP][sS]([0-9]+)?([^[:alnum:]]|$) ]]
}

is_switch_host() {
    [[ $1 =~ [sS][wW] ]]
}

ipv4_prefix() {
    [[ $1 =~ ^([0-9]+\.[0-9]+\.[0-9]+)\.[0-9]+$ ]] && printf '%s\n' "${BASH_REMATCH[1]}"
}

# First three octets of the first local IPv4 address in 10.204.x.x or 10.198.x.x;
# core switches live on that subnet at .134 (core 1), .135 (core 2), ...
find_switch_prefix() {
    local addresses
    if command -v ip >/dev/null 2>&1; then
        addresses=$(ip -4 -o addr show 2>/dev/null | awk '{split($4, a, "/"); print a[1]}')
    else
        addresses=$(hostname -I 2>/dev/null | tr ' ' '\n')
    fi
    awk -F. '$1 == 10 && ($2 == 204 || $2 == 198) { print $1 "." $2 "." $3; exit }' <<<"$addresses"
}
switch_prefix=$(find_switch_prefix)

declare -a host_names=()
declare -a host_addresses=()
declare -a host_macs=()
while IFS=$'\t' read -r name address mac; do
    [[ -n $name && -n $address ]] || continue
    host_names+=("$name")
    host_addresses+=("$address")
    host_macs+=("${mac:--}")
done < <(read_hosts "${config_files[@]}")

if ((${#host_names[@]} == 0)); then
    printf 'No host blocks with fixed-address directives found in %s\n' "$CONFIG_GLOB" >&2
    exit 1
fi

declare -a display_types=()
declare -a display_labels=()
declare -a display_host_indexes=()
declare -a display_indents=()
declare -a host_is_octe=()
declare -a host_is_ups=()
declare -a host_is_switch=()
declare -a host_ups_placed=()
for index in "${!host_names[@]}"; do
    if is_octe_host "${host_names[index]}"; then
        host_is_octe[index]=1
        host_is_ups[index]=0
    elif is_ups_host "${host_names[index]}"; then
        host_is_octe[index]=0
        host_is_ups[index]=1
    else
        host_is_octe[index]=0
        host_is_ups[index]=0
    fi
    host_ups_placed[index]=0
    if is_switch_host "${host_names[index]}"; then
        host_is_switch[index]=1
    else
        host_is_switch[index]=0
    fi
done
octe_section_added=0
for index in "${!host_names[@]}"; do
    ((host_is_octe[index])) || continue
    if ((octe_section_added == 0)); then
        display_types+=('header')
        display_labels+=('[OCTE]')
        display_host_indexes+=('-1')
        display_indents+=('0')
        octe_section_added=1
    fi
    display_types+=('host')
    display_labels+=('')
    display_host_indexes+=("$index")
    display_indents+=('1')
    octe_prefix=$(ipv4_prefix "${host_addresses[index]}")
    [[ -n $octe_prefix ]] || continue
    for ups_index in "${!host_names[@]}"; do
        ((host_is_ups[ups_index])) || continue
        ((host_ups_placed[ups_index])) && continue
        ups_prefix=$(ipv4_prefix "${host_addresses[ups_index]}")
        [[ $ups_prefix == "$octe_prefix" ]] || continue
        display_types+=('host')
        display_labels+=('')
        display_host_indexes+=("$ups_index")
        display_indents+=('2')
        host_ups_placed[ups_index]=1
    done
done
ups_section_added=0
for index in "${!host_names[@]}"; do
    ((host_is_ups[index])) || continue
    ((host_ups_placed[index])) && continue
    if ((octe_section_added)); then
        display_types+=('host')
        display_labels+=('')
        display_host_indexes+=("$index")
        display_indents+=('1')
        host_ups_placed[index]=1
        continue
    fi
    if ((ups_section_added == 0)); then
        display_types+=('header')
        display_labels+=('[UPS]')
        display_host_indexes+=('-1')
        display_indents+=('0')
        ups_section_added=1
    fi
    display_types+=('host')
    display_labels+=('')
    display_host_indexes+=("$index")
    display_indents+=('1')
    host_ups_placed[index]=1
done
declare -A enclosure_switches=()
declare -A enclosure_has_controller=()
declare -a host_enclosure_id=()
for index in "${!host_names[@]}"; do
    ((host_is_octe[index] || host_is_ups[index])) && continue
    if [[ ${host_names[index]} =~ c([0-9]+)n([0-9]+)r([0-9]+)e([0-9]+) ]]; then
        host_enclosure_id[index]="c${BASH_REMATCH[1]}n${BASH_REMATCH[2]}r${BASH_REMATCH[3]}e${BASH_REMATCH[4]}"
        if ((host_is_switch[index])); then
            enclosure_switches[${host_enclosure_id[index]}]+="$index "
        else
            enclosure_has_controller[${host_enclosure_id[index]}]=1
        fi
    fi
done
declare -a display_order=()
for index in "${!host_names[@]}"; do
    ((host_is_octe[index] || host_is_ups[index])) && continue
    eid=${host_enclosure_id[index]:-}
    if [[ -n $eid ]] && ((host_is_switch[index])) && [[ -n ${enclosure_has_controller[$eid]:-} ]]; then
        continue
    fi
    if [[ -n $eid ]] && ((host_is_switch[index] == 0)) && [[ -n ${enclosure_switches[$eid]:-} ]]; then
        for switch_index in ${enclosure_switches[$eid]}; do
            display_order+=("$switch_index")
        done
        enclosure_switches[$eid]=''
    fi
    display_order+=("$index")
done
previous_core=''
core_position=0
declare -A core_switch_index=()
for index in "${display_order[@]}"; do
    [[ ${host_names[index]} =~ c([0-9]+)n([0-9]+)r([0-9]+)(e([0-9]+))? ]] || continue
    core="c${BASH_REMATCH[1]}"
    if [[ $core != "$previous_core" ]]; then
        previous_core=$core
        core_position=$((core_position + 1))
        if [[ -n $switch_prefix ]]; then
            host_names+=("${core}-core-switch")
            host_addresses+=("$switch_prefix.$((133 + core_position))")
            host_macs+=('-')
            core_switch_index[$core]=$((${#host_names[@]} - 1))
        fi
    fi
done

result_dir=$(mktemp -d)
interactive_output=0
declare -a ping_pids=()
pings_in_flight=0
cleanup() {
    if ((${#ping_pids[@]} > 0)); then
        kill "${ping_pids[@]}" 2>/dev/null || true
        wait 2>/dev/null || true
    fi
    rm -rf -- "$result_dir"
    if ((interactive_output)); then
        printf '\033[?25h\033[?1049l'
    fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

start_pings() {
    local index
    ping_pids=()
    for index in "${!host_names[@]}"; do
        command ping -n -c 1 -W "$TIMEOUT" "${host_addresses[index]}" >"$result_dir/$index.raw" 2>&1 &
        ping_pids[index]=$!
    done
    pings_in_flight=1
}

collect_pings() {
    local index output latency
    ((pings_in_flight)) || return 0
    for index in "${!ping_pids[@]}"; do
        if wait "${ping_pids[index]}"; then
            output=$(<"$result_dir/$index.raw")
            latency=-
            if [[ $output =~ time=([0-9]+([.][0-9]+)?) ]]; then
                latency=${BASH_REMATCH[1]}
            fi
            printf 'UP\t%s\n' "$latency" >"$result_dir/$index"
        else
            printf 'DOWN\t-\n' >"$result_dir/$index"
        fi
        rm -f -- "$result_dir/$index.raw"
    done
    ping_pids=()
    pings_in_flight=0
}

start_pings

previous_core=''
previous_node=''
for index in "${display_order[@]}"; do
    host_indent=0
    if [[ ${host_names[index]} =~ c([0-9]+)n([0-9]+)r([0-9]+)(e([0-9]+))? ]]; then
        core="c${BASH_REMATCH[1]}"
        node_value=${BASH_REMATCH[2]}
        rack_value=${BASH_REMATCH[3]}
        equipment_value=${BASH_REMATCH[5]}

        if [[ $core != "$previous_core" ]]; then
            display_types+=('header')
            display_labels+=("[$core]")
            display_host_indexes+=('-1')
            display_indents+=('0')
            previous_core=$core
            previous_node=''
            if [[ -n ${core_switch_index[$core]+x} ]]; then
                display_types+=('host')
                display_labels+=('')
                display_host_indexes+=("${core_switch_index[$core]}")
                display_indents+=('1')
            fi
        fi
        host_indent=1
        if [[ ! $node_value =~ ^0+$ ]]; then
            node="n$node_value"
            if [[ $node != "$previous_node" ]]; then
                display_types+=('header')
                display_labels+=("[$node]")
                display_host_indexes+=('-1')
                display_indents+=("$host_indent")
                previous_node=$node
            fi
            ((host_indent++))
        fi
        if [[ ! $rack_value =~ ^0+$ ]]; then
            ((host_indent++))
        fi
        if [[ -n $equipment_value && ! $equipment_value =~ ^0+$ ]]; then
            ((host_indent++))
            if ((host_is_switch[index] == 0)); then
                ((host_indent++))
            fi
        fi
    else
        if [[ $previous_core != Unclassified ]]; then
            display_types+=('header')
            display_labels+=('[Unclassified]')
            display_host_indexes+=('-1')
            display_indents+=('0')
            previous_core='Unclassified'
            previous_node=''
        fi
        host_indent=1
    fi
    display_types+=('host')
    display_labels+=('')
    display_host_indexes+=("$index")
    display_indents+=("$host_indent")
done

full_types=("${display_types[@]}")
full_labels=("${display_labels[@]}")
full_host_indexes=("${display_host_indexes[@]}")
full_indents=("${display_indents[@]}")

apply_core_collapse() {
    local i current_core idx status
    declare -A collapsed_cores=()

    if ((collapse_down_cores)) && ((${#core_switch_index[@]} > 0)); then
        for current_core in "${!core_switch_index[@]}"; do
            idx=${core_switch_index[$current_core]}
            if [[ -f $result_dir/$idx ]]; then
                IFS=$'\t' read -r status _ <"$result_dir/$idx"
                if [[ $status != UP ]]; then
                    collapsed_cores[$current_core]=1
                fi
            fi
        done
    fi

    display_types=()
    display_labels=()
    display_host_indexes=()
    display_indents=()
    current_core=''
    for i in "${!full_types[@]}"; do
        if [[ ${full_types[i]} == header && ${full_indents[i]} == 0 ]]; then
            if [[ ${full_labels[i]} =~ ^\[(c[0-9]+)\]$ ]]; then
                current_core=${BASH_REMATCH[1]}
            else
                current_core=''
            fi
        fi
        if ((collapse_down_cores)) && [[ -n $current_core && -n ${collapsed_cores[$current_core]:-} ]]; then
            if [[ ${full_types[i]} == header && ${full_indents[i]} == 0 ]]; then
                true
            elif [[ ${full_types[i]} == host && ${host_names[${full_host_indexes[i]}]} == "$current_core-core-switch" ]]; then
                true
            else
                continue
            fi
        fi
        display_types+=("${full_types[i]}")
        display_labels+=("${full_labels[i]}")
        display_host_indexes+=("${full_host_indexes[i]}")
        display_indents+=("${full_indents[i]}")
    done
}

wait_for_refresh_or_navigation() {
    local key='' sequence=''

    if ((!interactive_output)) || [[ ! -t 0 ]]; then
        sleep "$INTERVAL"
        return
    fi

    if ! IFS= read -rsn1 -t "$INTERVAL" key; then
        return
    fi

    case "$key" in
        m|M)
            show_mac=$((1 - show_mac))
            skip_ping=1
            ;;
        c|C)
            collapse_down_cores=$((1 - collapse_down_cores))
            skip_ping=1
            ;;
        $'\e')
            IFS= read -rsn2 -t 0.1 sequence || true
            case "$sequence" in
                '[C')
                    if ((current_page + 1 < page_count)); then
                        current_page=$((current_page + 1))
                    fi
                    ;;
                '[D')
                    if ((current_page > 0)); then
                        current_page=$((current_page - 1))
                    fi
                    ;;
            esac
            ;;
    esac
}

# Indent-0 section headers occupy the first grid row by themselves so a
# multi-column page never puts host IPs/names on that line. Remaining items
# fill the rows below. Continuation pages repeat the current section header.
set_page_capacity() {
    local start=$1
    local body

    if ((grid_rows <= 1)); then
        page_capacity=$((grid_rows * column_count))
        ((page_capacity > 0)) || page_capacity=1
        return
    fi

    body=$(((grid_rows - 1) * column_count))
    ((body > 0)) || body=1
    if ((start < ${#display_types[@]})) &&
        [[ ${display_types[start]} == header && ${display_indents[start]} == 0 ]]; then
        page_capacity=$((1 + body))
    else
        page_capacity=$body
    fi
}

# Page 0 starts at the beginning of the list. Later pages start at a core
# header ([cN]) rather than in the middle of a core. A core taller than one
# page continues from the cut; OCTE/Unclassified use the same section rule.
build_page_starts() {
    local n=${#display_types[@]}
    local start=0
    local end=0
    local section=0
    local next=0
    local i=0

    page_starts=(0)
    ((n > 0)) || return 0

    while true; do
        set_page_capacity "$start"
        end=$((start + page_capacity))
        ((end < n)) || break

        section=0
        for ((i = end; i >= 0; i--)); do
            if [[ ${display_types[i]} == header && ${display_indents[i]} == 0 ]]; then
                section=$i
                break
            fi
        done

        if [[ ${display_labels[section]} =~ ^\[c[0-9]+\]$ ]] && ((section > start)); then
            next=$section
        elif [[ ${display_labels[section]} == '[OCTE]' ]]; then
            next=$end
            for ((i = section + 1; i < n; i++)); do
                if [[ ${display_types[i]} == header && ${display_labels[i]} =~ ^\[c[0-9]+\]$ ]]; then
                    next=$i
                    break
                fi
            done
            ((next > start)) || next=$end
        elif ((section > start)); then
            next=$section
        else
            next=$end
        fi

        ((next > start)) || break
        page_starts+=("$next")
        start=$next
    done
}

if [[ -t 1 && ${TERM:-dumb} != dumb ]]; then
    interactive_output=1
    printf '\033[?1049h\033[?25l\033[2J\033[H'
fi

current_page=0
if [[ ${FHM_TEST_PAGE:-} =~ ^[1-9][0-9]*$ ]]; then
    current_page=$((FHM_TEST_PAGE - 1))
fi
skip_ping=0
while true; do
    if ((skip_ping == 0)); then
        ((pings_in_flight)) || start_pings
        collect_pings
    fi
    skip_ping=0
    apply_core_collapse

    up_count=0
    for index in "${!host_names[@]}"; do
        if [[ -f $result_dir/$index ]]; then
            IFS=$'\t' read -r status _ <"$result_dir/$index"
            [[ $status == UP ]] && up_count=$((up_count + 1))
        fi
    done
    host_total=${#host_names[@]}
    if ((host_total > 0)); then
        up_percent=$((up_count * 100 / host_total))
    else
        up_percent=0
    fi

    if ((interactive_output)); then
        printf '\033[H'
        terminal_rows=$(tput lines 2>/dev/null || printf '24')
        terminal_columns=$(tput cols 2>/dev/null || printf '80')
    else
        terminal_rows=$((${#display_types[@]} + 4))
        terminal_columns=80
    fi
    if [[ ${FHM_TEST_ROWS:-} =~ ^[1-9][0-9]*$ ]]; then
        terminal_rows=$FHM_TEST_ROWS
    fi
    if [[ ${FHM_TEST_COLS:-} =~ ^[1-9][0-9]*$ ]]; then
        terminal_columns=$FHM_TEST_COLS
    fi

    [[ $terminal_rows =~ ^[0-9]+$ ]] || terminal_rows=24
    [[ $terminal_columns =~ ^[0-9]+$ ]] || terminal_columns=80
    layout_width=$((terminal_columns > 1 ? terminal_columns - 1 : 1))
    grid_rows=$((terminal_rows - 4))
    ((grid_rows > 0)) || grid_rows=1

    minimum_cell_width=46
    ((show_mac)) && minimum_cell_width=64
    max_columns=$((layout_width / minimum_cell_width))
    ((max_columns > 0)) || max_columns=1
    needed_columns=$((${#display_types[@]} + grid_rows - 1))
    needed_columns=$((needed_columns / grid_rows))
    ((needed_columns > 0)) || needed_columns=1
    if ((needed_columns < max_columns)); then
        column_count=$needed_columns
    else
        column_count=$max_columns
    fi

    declare -a page_starts=()
    build_page_starts
    page_count=${#page_starts[@]}
    ((page_count > 0)) || page_count=1
    ((current_page < page_count)) || current_page=0
    page_start=${page_starts[current_page]:-0}
    set_page_capacity "$page_start"
    if ((current_page + 1 < page_count)); then
        page_item_count=$((page_starts[current_page + 1] - page_start))
    else
        page_item_count=$((${#display_types[@]} - page_start))
    fi
    ((page_item_count > 0)) || page_item_count=0
    ((page_item_count <= page_capacity)) || page_item_count=$page_capacity
    section_header=''
    grid_index=$page_start
    grid_count=$page_item_count
    if ((grid_rows > 1 && page_item_count > 0)); then
        if [[ ${display_types[page_start]} == header && ${display_indents[page_start]} == 0 ]]; then
            section_header=${display_labels[page_start]}
            grid_index=$((page_start + 1))
            grid_count=$((page_item_count - 1))
        else
            for ((i = page_start; i >= 0; i--)); do
                if [[ ${display_types[i]} == header && ${display_indents[i]} == 0 ]]; then
                    section_header=${display_labels[i]}
                    break
                fi
            done
        fi
    fi
    ((grid_count > 0)) || grid_count=0
    body_rows=$grid_rows
    if [[ -n $section_header ]]; then
        body_rows=$((grid_rows - 1))
    fi
    ((body_rows > 0)) || body_rows=1
    if ((grid_count > 0)); then
        needed_columns=$((grid_count + body_rows - 1))
        needed_columns=$((needed_columns / body_rows))
        ((needed_columns > 0)) || needed_columns=1
        if ((needed_columns < max_columns)); then
            column_count=$needed_columns
        else
            column_count=$max_columns
        fi
    else
        column_count=1
    fi
    # Fill each column to body_rows before opening another column.
    if ((column_count <= 1)); then
        page_rows=$grid_count
        ((page_rows > 0)) || page_rows=0
        ((page_rows <= body_rows)) || page_rows=$body_rows
    else
        page_rows=$body_rows
    fi
    cell_width=$((layout_width / column_count))
    separator_width=1
    host_width=1
    for ((entry_index = grid_index; entry_index < grid_index + grid_count; entry_index++)); do
        [[ ${display_types[entry_index]} == host ]] || continue
        index=${display_host_indexes[entry_index]}
        candidate_width=$((${display_indents[entry_index]} + ${#host_names[index]}))
        ((candidate_width > host_width)) && host_width=$candidate_width
    done
    maximum_host_width=$((cell_width - separator_width - 1))
    ((host_width <= maximum_host_width)) || host_width=$maximum_host_width
    ((host_width > 0)) || host_width=1
    detail_width=$((cell_width - host_width - separator_width))

    printf -v heading '%s  build %s  %(%Y-%m-%d %H:%M:%S)T  |  UP %d%% (%d/%d)' \
        "$TITLE" "$BUILD" -1 "$up_percent" "$up_count" "$host_total"
    printf '%.*s\n\n' "$layout_width" "$heading"

    if [[ -n $section_header ]]; then
        if ((interactive_output)); then
            printf '\033[1;36m%-*.*s\033[0m\n' "$layout_width" "$layout_width" "$section_header"
        else
            printf '%-*.*s\n' "$layout_width" "$layout_width" "$section_header"
        fi
    fi

    for ((row = 0; row < page_rows; row++)); do
        for ((column = 0; column < column_count; column++)); do
            entry_index=$((grid_index + column * page_rows + row))
            if ((entry_index >= grid_index + grid_count)); then
                printf '%*s' "$cell_width" ''
                continue
            fi

            if [[ ${display_types[entry_index]} == header ]]; then
                printf -v indentation '%*s' "${display_indents[entry_index]}" ''
                header="${indentation}${display_labels[entry_index]}"
                if ((interactive_output)); then
                    printf '\033[1;36m%-*.*s\033[0m' "$cell_width" "$cell_width" "$header"
                else
                    printf '%-*.*s' "$cell_width" "$cell_width" "$header"
                fi
                continue
            fi

            index=${display_host_indexes[entry_index]}
            printf -v indentation '%*s' "${display_indents[entry_index]}" ''
            host_display="${indentation}${host_names[index]}"
            IFS=$'\t' read -r status latency <"$result_dir/$index"
            latency_text=$latency
            [[ $latency == - ]] || latency_text="${latency}ms"
            if ((show_mac)); then
                details="${host_addresses[index]}  ${host_macs[index]}  $latency_text"
            else
                details="${host_addresses[index]}  $latency_text"
            fi

            if ((interactive_output)) && [[ $status == UP ]]; then
                printf '\033[32m%-*.*s\033[0m' "$host_width" "$host_width" "$host_display"
            elif ((interactive_output)); then
                printf '\033[31m%-*.*s\033[0m' "$host_width" "$host_width" "$host_display"
            else
                printf '%-*.*s' "$host_width" "$host_width" "$host_display"
            fi
            printf '%*s' "$separator_width" ''
            if ((detail_width > 0)); then
                printf '%-*.*s' "$detail_width" "$detail_width" "$details"
            fi
        done
        printf '\n'
    done

    printf -v footer 'Refresh: %ss | Hosts: %d | Page: %d/%d | Left/Right: page | M: MAC | C: collapse | Ctrl-C: stop' \
        "$INTERVAL" "${#host_names[@]}" "$((current_page + 1))" "$page_count"
    printf '\n%.*s' "$layout_width" "$footer"
    if ((interactive_output)); then
        printf '\033[J'
    else
        printf '\n'
    fi
    wait_for_refresh_or_navigation
done
