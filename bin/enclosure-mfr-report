#!/usr/bin/env bash
# Generated by Github Copilot on behalf of Tim Livingston
# enclosure-mfr-report — collect enclosure manufacturing logs and write reports
set -euo pipefail

PROG="$(basename "$0")"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
source "${ROOT}/lib/bash/ssh_session.sh"
# shellcheck source=/dev/null
source "${ROOT}/lib/bash/collect_enclosure_logs.sh"

ARGS_HOST=""
ARGS_USER=""
ARGS_PORT=22
ARGS_FROM_DIR=""
ARGS_FROM_PACKAGE=""
ARGS_OUT_DIR=""
ARGS_REMOTE_ROOT="/opt/fos_deployment/logs/enclosure"
ARGS_KEEP_PACKAGE=0
ARGS_INSECURE_HOST_KEY=0

usage() {
  cat <<EOF
Usage: ${PROG} --host HOST [--user USER] [--port 22]
       ${PROG} --from-dir DIR
       ${PROG} --from-package FILE.tar.gz

Collect enclosure *.log files, rename them using cluster/node/rack/enclosure
(c/n/r/e) tokens from each path, then analyze manufacturing deviations.

SSH mode prompts on a TTY for username (if omitted) and password. The
password is never stored, logged, or accepted as a CLI flag.

Options:
  --host HOST              SSH host (prompts for credentials)
  --user USER              SSH username (prompted if omitted)
  --port PORT              SSH port (default: 22)
  --from-dir DIR           Skip SSH; collect from a local tree
  --from-package FILE      Skip SSH; unpack an existing tar.gz
  --out-dir DIR            Output directory (default: ./var/enclosure-mfr-report/<timestamp>)
  --remote-root PATH       Remote log root (default: ${ARGS_REMOTE_ROOT})
  --keep-package           Keep package.tar.gz in the output directory
  --insecure-host-key      Disable SSH host key checking (opt-in)
  -h, --help               Show this help and exit

Outputs in --out-dir:
  package/   manifest.txt   deviations.csv
  stats-report.md   corrective-action-report.md   unparsed.txt

Requires: bash, python3, tar. SSH mode also needs ssh and sshpass.
EOF
}

die() {
  printf '%s: %s\n' "$PROG" "$*" >&2
  exit 1
}

detect_python() {
  local cand
  for cand in python3 python; do
    if command -v "$cand" >/dev/null 2>&1 && "$cand" -c "import sys" >/dev/null 2>&1; then
      printf '%s' "$cand"
      return
    fi
  done
  die "python3 is required"
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      --host)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        ARGS_HOST="$2"
        shift 2
        ;;
      --user)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        ARGS_USER="$2"
        shift 2
        ;;
      --port)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        [[ "$2" =~ ^[1-9][0-9]*$ ]] || die "invalid port: $2"
        ARGS_PORT="$2"
        shift 2
        ;;
      --from-dir)
        [[ $# -ge 2 ]] || die "$1 requires a path"
        ARGS_FROM_DIR="$2"
        shift 2
        ;;
      --from-package)
        [[ $# -ge 2 ]] || die "$1 requires a path"
        ARGS_FROM_PACKAGE="$2"
        shift 2
        ;;
      --out-dir)
        [[ $# -ge 2 ]] || die "$1 requires a path"
        ARGS_OUT_DIR="$2"
        shift 2
        ;;
      --remote-root)
        [[ $# -ge 2 ]] || die "$1 requires a path"
        ARGS_REMOTE_ROOT="$2"
        shift 2
        ;;
      --keep-package)
        ARGS_KEEP_PACKAGE=1
        shift
        ;;
      --insecure-host-key)
        ARGS_INSECURE_HOST_KEY=1
        shift
        ;;
      --password)
        die "passwords cannot be passed on the command line; use the TTY prompt"
        ;;
      --)
        shift
        break
        ;;
      -*)
        die "unknown option: $1"
        ;;
      *)
        die "unexpected argument: $1"
        ;;
    esac
  done
  [[ $# -eq 0 ]] || die "unexpected argument: $1"
}

default_out_dir() {
  local ts
  ts="$(date +%Y%m%dT%H%M%S)"
  printf '%s/var/enclosure-mfr-report/%s' "$ROOT" "$ts"
}

run_analyzer() {
  local package_dir="$1" out_dir="$2"
  local py
  py="$(detect_python)"
  PYTHONPATH="${ROOT}/lib/python${PYTHONPATH:+:$PYTHONPATH}" \
    "$py" -m enclosure_mfr \
      --from-dir "$package_dir" \
      --out-dir "$out_dir" \
      --host "${ARGS_HOST}" \
      --user "${ARGS_USER}" \
      --remote-root "${ARGS_REMOTE_ROOT}"
}

collect_ssh() {
  command -v ssh >/dev/null 2>&1 || die "ssh is required"
  command -v sshpass >/dev/null 2>&1 || die "sshpass is required for password authentication"
  command -v tar >/dev/null 2>&1 || die "tar is required"
  SSH_HOST="$ARGS_HOST"
  SSH_USER="$ARGS_USER"
  SSH_PORT="$ARGS_PORT"
  SSH_INSECURE_HOST_KEY="$ARGS_INSECURE_HOST_KEY"
  ssh_session_prompt || exit 1
  local raw="$1"
  mkdir -p "$raw"
  local rc=0
  ssh_session_tar_logs "$ARGS_REMOTE_ROOT" >"${raw}/.incoming.tar.gz" || rc=$?
  ssh_session_clear
  ARGS_USER="$SSH_USER"
  [[ $rc -eq 0 ]] || die "SSH collect failed (rc=${rc})"
  unpack_package "${raw}/.incoming.tar.gz" "$raw"
  rm -f "${raw}/.incoming.tar.gz"
}

main() {
  parse_args "$@"
  local modes=0
  [[ -n "$ARGS_HOST" ]] && modes=$((modes + 1))
  [[ -n "$ARGS_FROM_DIR" ]] && modes=$((modes + 1))
  [[ -n "$ARGS_FROM_PACKAGE" ]] && modes=$((modes + 1))
  [[ $modes -eq 1 ]] || die "specify exactly one of --host, --from-dir, --from-package"

  local out="${ARGS_OUT_DIR:-$(default_out_dir)}"
  mkdir -p "$out/package" "$out/raw"
  local manifest="$out/manifest.txt"
  printf 'source\tdest\tstatus\tc\tn\tr\te\tsize\tmtime\n' >"$manifest"

  if [[ -n "$ARGS_HOST" ]]; then
    collect_ssh "$out/raw"
    collect_from_dir "$out/raw" "$out/package" "$manifest"
  elif [[ -n "$ARGS_FROM_DIR" ]]; then
    [[ -d "$ARGS_FROM_DIR" ]] || die "not a directory: $ARGS_FROM_DIR"
    collect_from_dir "$ARGS_FROM_DIR" "$out/package" "$manifest"
  else
    [[ -f "$ARGS_FROM_PACKAGE" ]] || die "not a file: $ARGS_FROM_PACKAGE"
    unpack_package "$ARGS_FROM_PACKAGE" "$out/raw"
    collect_from_dir "$out/raw" "$out/package" "$manifest"
  fi

  if [[ "$ARGS_KEEP_PACKAGE" -eq 1 ]]; then
    pack_package "$out/package" "$out/package.tar.gz"
  fi

  run_analyzer "$out/package" "$out"
  printf '%s: reports written to %s\n' "$PROG" "$out"
}

main "$@"
